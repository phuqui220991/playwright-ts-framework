{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020", "DOM"],
        "moduleResolution": "bundler",
        "types": ["node", "@playwright/test"],
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "paths": {
            "@api/*": ["./src/api/*"],
            "@components/*": ["./src/components/*"],
            "@constants/*": ["./src/constants/*"],
            "@data/*": ["./src/data/*"],
            "@fixtures/*": ["./src/fixtures/*"],
            "@pages/*": ["./src/pages/*"],
            "@utils/*": ["./src/utils/*"]
        }
    },
    "include": ["tests", "src", "playwright.config.ts"]
}
