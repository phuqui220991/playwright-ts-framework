{
    "name": "playwright-ts-framework",
    "version": "1.0.0",
    "description": "",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "npx playwright test",
        "test:example": "cross-env ENV=example npx playwright test",
        "test:headed": "npx playwright test --headed",
        "test:debug": "npx playwright test --debug",
        "test:ui-mode": "npx playwright test --ui",
        "report": "npx playwright show-report",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phuqui220991/playwright-ts-framework.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/phuqui220991/playwright-ts-framework/issues"
    },
    "homepage": "https://github.com/phuqui220991/playwright-ts-framework#readme",
    "devDependencies": {
        "@faker-js/faker": "^10.5.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "zod": "^4.5.4"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write",
            "bash -c 'tsc --noEmit'"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
